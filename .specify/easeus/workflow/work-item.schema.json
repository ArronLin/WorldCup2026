{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Studio Work Item v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "framework", "kind", "title", "acceptance", "risks", "rules", "revision", "stage", "verification", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "framework": {"enum": ["speckit", "openspec"]},
    "kind": {"enum": ["feature", "bug", "quick", "change"]},
    "title": {"type": "string", "minLength": 1},
    "native_path": {"type": "string", "minLength": 1},
    "acceptance": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "source", "line"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
        "description": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1}
      }
    }},
    "risks": {"type": "array", "items": {"type": "string"}},
    "rules": {"type": "object"},
    "revision": {"type": "integer", "minimum": 1},
    "stage": {"enum": ["created", "assessed", "implementing", "verifying", "finished"]},
    "verification": {"enum": ["unverified", "partial", "failed", "passed"]},
    "events": {"type": "array", "items": {"type": "object"}}
  }
}
