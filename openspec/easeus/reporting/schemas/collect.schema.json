{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "collect",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "version"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "test_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "level": {
                "enum": [
                  "unit",
                  "integration",
                  "e2e",
                  "other"
                ]
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "container": {
                "type": "string"
              },
              "parameters": {
                "type": "string"
              },
              "file": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "skipped",
                  "todo",
                  "not_run",
                  "error",
                  "flaky",
                  "expected_failure",
                  "unknown"
                ]
              },
              "original_status": {
                "type": "string",
                "minLength": 1
              },
              "attempts": {
                "type": "integer",
                "minimum": 1
              },
              "duration_ms": {
                "type": "number",
                "minimum": 0
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "failure": {
                "type": "string"
              },
              "failure_kind": {
                "enum": [
                  "assertion",
                  "infrastructure",
                  "unknown",
                  "none"
                ]
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": [
              "test_id",
              "provider",
              "level",
              "locator",
              "container",
              "parameters",
              "file",
              "status",
              "original_status",
              "attempts",
              "duration_ms",
              "run_id",
              "failure",
              "failure_kind",
              "evidence"
            ]
          }
        },
        "global_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "provider",
        "run_id",
        "tests",
        "global_errors"
      ]
    },
    "coverage": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "provider": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "version"
              ]
            },
            "scope": {
              "const": "unit"
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "source_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_hash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "executable_lines": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "hit_lines": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "source_mapping": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "version": {
                        "const": 1
                      },
                      "kind": {
                        "const": "statement-ranges"
                      },
                      "ranges": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "start": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "end": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "executable_line": {
                              "type": "integer",
                              "minimum": 1
                            }
                          },
                          "required": [
                            "start",
                            "end",
                            "executable_line"
                          ]
                        }
                      },
                      "baseline_path": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "version",
                      "kind",
                      "ranges"
                    ]
                  }
                },
                "required": [
                  "path",
                  "source_hash",
                  "executable_lines",
                  "hit_lines"
                ]
              }
            }
          },
          "required": [
            "schema_version",
            "provider",
            "scope",
            "run_id",
            "source_fingerprint",
            "files"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "results",
    "coverage",
    "diagnostics"
  ]
}
