{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": 1
    },
    "tool_version": {
      "const": "1.0.0"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "confirmed": {
      "type": "boolean"
    },
    "production_include": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "production_exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_include": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
          },
          "level": {
            "enum": [
              "unit",
              "integration",
              "e2e",
              "other"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "results": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "format": {
                "enum": [
                  "unified",
                  "junit",
                  "trx"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "version"
                ]
              }
            },
            "required": [
              "format",
              "path",
              "provider"
            ]
          },
          "coverage": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "format": {
                    "enum": [
                      "unified",
                      "lcov",
                      "cobertura"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "provider": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "id",
                      "version"
                    ]
                  },
                  "mapping_path": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "format",
                  "path",
                  "provider"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "collect": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "cwd": {
                    "type": "string",
                    "minLength": 1
                  },
                  "output": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "command",
                  "args",
                  "cwd",
                  "output"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "level",
          "command",
          "args",
          "cwd",
          "results",
          "coverage",
          "collect"
        ]
      }
    },
    "capability_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "framework": {
      "enum": [
        "speckit",
        "openspec"
      ]
    }
  },
  "required": [
    "schema_version",
    "contract_version",
    "tool_version",
    "adapter",
    "confirmed",
    "production_include",
    "production_exclude",
    "test_include",
    "test_exclude",
    "suites",
    "capability_notes"
  ]
}
