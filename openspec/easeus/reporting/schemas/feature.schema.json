{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "spec_path": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "rules_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy": {
      "type": "object"
    },
    "config": {
      "type": "object"
    },
    "specification_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "feature",
    "name",
    "spec_path",
    "created_at",
    "baseline_id",
    "tool_version",
    "rules_fingerprint",
    "config_fingerprint",
    "policy",
    "config"
  ]
}
