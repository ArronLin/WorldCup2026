{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "baseline",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "snapshot",
        "git-commit"
      ]
    },
    "head": {
      "type": [
        "string",
        "null"
      ]
    },
    "dirty": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "feature_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "created_at",
    "mode",
    "head",
    "dirty",
    "source_commit",
    "files",
    "feature_fingerprint"
  ]
}
