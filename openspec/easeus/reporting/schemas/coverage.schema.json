{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coverage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "scope": {
      "const": "unit"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "executable_lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "hit_lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "source_mapping": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "const": 1
              },
              "kind": {
                "const": "statement-ranges"
              },
              "ranges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "executable_line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "start",
                    "end",
                    "executable_line"
                  ]
                }
              },
              "baseline_path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "version",
              "kind",
              "ranges"
            ]
          }
        },
        "required": [
          "path",
          "source_hash",
          "executable_lines",
          "hit_lines"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "provider",
    "scope",
    "run_id",
    "source_fingerprint",
    "files"
  ]
}
